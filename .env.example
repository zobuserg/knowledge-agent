# OpenAI — recommended (best quality, multilingual embeddings)
# Without a key, everything falls back to local Ollama (free, slower).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Ollama — local fallback (no key needed; requires Ollama running)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# App config
CHROMA_PERSIST_DIR=data/processed
COLLECTION_NAME=knowledge_base
CHUNK_SIZE=512
CHUNK_OVERLAP=64
